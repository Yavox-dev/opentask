{
  "name": "opentask",
  "private": true,
  "description": "Plateforme open source de gestion de projets collaboratifs",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
